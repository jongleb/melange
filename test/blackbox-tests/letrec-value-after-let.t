A recursive value that follows another binding compiles

  $ . ./setup.sh
  $ cat > main.ml <<EOF
  > external opaque : 'a -> 'a = "%opaque"
  > let v = opaque 3
  > let rec xs = 1 :: xs
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  
  const v = 3;
  
  let xs = {};
  
  xs.hd = 1;
  
  xs.tl = xs;
  
  module.exports = {
    v,
    xs,
  }
  /* v Not a pure module */
