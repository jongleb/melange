A path through a local submodule constrained by a signature reaches the
function itself, so the call is direct

  $ . ./setup.sh
  $ cat > main.ml <<EOF
  > let run env =
  >   let module P : sig
  >     module Peek : sig
  >       val token : int -> int -> int
  >     end
  >   end = struct
  >     module Peek = struct
  >       let loc x = x + 1
  >       let token a b = (a * b) + loc a
  >     end
  >   end in
  >   P.Peek.token env 2 + P.Peek.token 2 env
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  
  function run(env) {
    const token = function (a, b) {
      return Math.imul(a, b) + (a + 1 | 0) | 0;
    };
    return token(env, 2) + token(2, env) | 0;
  }
  
  module.exports = {
    run,
  }
  /* No side effect */
