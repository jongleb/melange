An application to one argument is direct when the type of the callee is
`a -> r` and no expansion of `r` is a function type: base types, tuples,
records and variants. Type variables, abstract types, unboxed types and
`Lazy.t` may hide a function, so their applications keep `Curry`

  $ . ./setup.sh
  $ cat > main.ml <<EOF
  > type r = { a : int }
  > type u = { f : int -> int } [@@unboxed]
  > let unit_ (k : int -> unit) x = k x
  > let bool_ (p : int -> bool) x = p x
  > let record (k : int -> r) x = k x
  > let tuple (k : int -> int * int) x = k x
  > let arrow (k : int -> int -> int) x = k x
  > let variable (k : int -> 'a) x = k x
  > let unboxed (k : int -> u) x = k x
  > let lazy_ (k : int -> (int -> int) Lazy.t) x = k x
  > let two (k : int -> int -> unit) x y = k x y
  > EOF

  $ melc main.ml
  // Generated by Melange
  'use strict';
  
  const Curry = require("melange.js/curry.js");
  
  function unit_(k, x) {
    k(x);
  }
  
  function bool_(p, x) {
    return p(x);
  }
  
  function record(k, x) {
    return k(x);
  }
  
  function tuple(k, x) {
    return k(x);
  }
  
  function arrow(k, x) {
    return Curry._1(k, x);
  }
  
  function variable(k, x) {
    return Curry._1(k, x);
  }
  
  function unboxed(k, x) {
    return Curry._1(k, x);
  }
  
  function lazy_(k, x) {
    return Curry._1(k, x);
  }
  
  function two(k, x, y) {
    Curry._2(k, x, y);
  }
  
  module.exports = {
    unit_,
    bool_,
    record,
    tuple,
    arrow,
    variable,
    unboxed,
    lazy_,
    two,
  }
  /* No side effect */
